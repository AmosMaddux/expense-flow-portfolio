erDiagram
    USER {
        uuid id PK
        uuid tenant_id UK
        text email UK
        timestamptz created_at
        timestamptz updated_at
    }

    ROLE {
        uuid id PK
        uuid tenant_id FK
        uuid user_id FK
        text name
        timestamptz created_at
    }

    TENANT_RATE_LIMIT_WINDOW {
        uuid tenant_id PK
        timestamptz window_started_at
        integer request_count
    }

    EXPENSE_REPORT {
        uuid id PK
        uuid tenant_id UK
        text current_stage
        boolean on_hold
        text hold_reason
        uuid owner
        text priority
        date due_date
        timestamptz created_at
        timestamptz updated_at
    }

    LINE_ITEM {
        uuid id PK
        uuid tenant_id FK
        uuid expense_report_id FK
        text merchant
        date expense_date
        numeric amount
        text currency
        text category
        timestamptz created_at
        timestamptz updated_at
    }

    USER ||--o{ ROLE : "tenant_id + id"
    USER ||..o{ EXPENSE_REPORT : "owner logical id"
    EXPENSE_REPORT ||--o{ LINE_ITEM : "tenant_id + id"
    TENANT_RATE_LIMIT_WINDOW }o..|| USER : "tenant scoped request"
