{
    "openapi": "3.1.0",
    "info": {
        "title": "ExpenseFlow Core Case Service API",
        "version": "1.0.0",
        "description": "Discoverable contract for Core Case Service Expense Report endpoints."
    },
    "servers": [
        {
            "url": "http://localhost:3000",
            "description": "Local development server"
        }
    ],
    "components": {
        "schemas": {
            "CreateExpenseReportRequest": {
                "type": "object",
                "properties": {
                    "tenant_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "owner": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "dueDate": {
                        "type": "string",
                        "format": "date"
                    },
                    "priority": {
                        "type": "string",
                        "enum": ["Low", "Normal", "High", "Urgent"],
                        "default": "Normal"
                    }
                },
                "required": ["tenant_id", "owner", "dueDate"]
            },
            "ExpenseReportResponse": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "tenantId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "owner": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "dueDate": {
                        "type": "string",
                        "format": "date"
                    },
                    "priority": {
                        "type": "string",
                        "enum": ["Low", "Normal", "High", "Urgent"]
                    },
                    "currentStage": {
                        "type": "string",
                        "enum": [
                            "Drafted",
                            "Submitted",
                            "Manager Approval",
                            "AP Review",
                            "Paid",
                            "Reconciled"
                        ]
                    },
                    "onHold": {
                        "type": "boolean"
                    },
                    "holdReason": {
                        "type": ["string", "null"]
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": [
                    "id",
                    "tenantId",
                    "owner",
                    "dueDate",
                    "priority",
                    "currentStage",
                    "onHold",
                    "holdReason",
                    "createdAt",
                    "updatedAt"
                ]
            },
            "MfaEnrollmentRequest": {
                "type": "object",
                "properties": {
                    "tenantId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "userId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    }
                },
                "required": ["tenantId", "userId", "email"]
            },
            "MfaEnrollmentResponse": {
                "type": "object",
                "properties": {
                    "provisioningUri": {
                        "type": "string"
                    }
                },
                "required": ["provisioningUri"]
            },
            "ProblemJson": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "detail": {
                        "type": "string"
                    },
                    "instance": {
                        "type": "string"
                    }
                },
                "required": ["type", "title", "status", "detail", "instance"]
            }
        },
        "parameters": {}
    },
    "paths": {
        "/auth/mfa/enroll": {
            "post": {
                "summary": "Enroll TOTP MFA",
                "description": "Provisions a TOTP secret for a tenant user and returns an authenticator-app provisioning URI.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/MfaEnrollmentRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "TOTP MFA enrollment created.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MfaEnrollmentResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Malformed MFA enrollment request.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemJson"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Unexpected server error.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemJson"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/expense-reports": {
            "post": {
                "summary": "Create an Expense Report",
                "description": "Creates an Expense Report case in Drafted stage and records the initial audit and stage-transition entries.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateExpenseReportRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Expense Report created.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ExpenseReportResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Malformed create request.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemJson"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Unexpected server error.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemJson"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/expense-reports/{id}": {
            "get": {
                "summary": "Get an Expense Report",
                "description": "Loads an Expense Report case by identifier.",
                "parameters": [
                    {
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "required": true,
                        "name": "id",
                        "in": "path"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Expense Report found.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ExpenseReportResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Expense Report not found.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemJson"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Unexpected server error.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemJson"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "webhooks": {}
}
