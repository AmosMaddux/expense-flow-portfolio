{
    "name": "expense-flow",
    "version": "1.0.0",
    "description": "ExpenseFlow node components",
    "main": "index.ts",
    "directories": {
        "doc": "docs"
    },
    "scripts": {
        "test": "npm run build && npx vitest run && UV_CACHE_DIR=/tmp/expense-flow-uv-cache uv run pytest",
        "build": "tsc --build",
        "start": "tsc --build && node backend/core-case-service/dist/index.js",
        "lint": "eslint . --max-warnings=0 && prettier --check \"**/*.{js,mjs,cjs,ts,json}\""
    },
    "repository": {
        "type": "git",
        "url": "git@github.com:AI-Native-2026-06-22-FedStack/expense-flow-project-team-3.git"
    },
    "engines": {
        "node": ">=24.0"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "workspaces": [
        "backend/core-case-service"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.7.0",
        "prettier": "^3.8.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0",
        "vitest": "^4.1.9"
    },
    "overrides": {
        "@esbuild-kit/esm-loader": "npm:tsx@^4.22.4"
    }
}
