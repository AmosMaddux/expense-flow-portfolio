{
    "name": "expense-flow",
    "version": "1.0.0",
    "description": "ExpenseFlow node components",
    "main": "index.ts",
    "directories": {
        "doc": "docs"
    },
    "scripts": {
        "test": "npm run test:typescript && UV_CACHE_DIR=/tmp/expense-flow-uv-cache uv run pytest",
        "test:typescript": "npm run build && vitest run --coverage",
        "ci:provider": "npm ci && uv sync && npm run test:provider",
        "test:provider": "UV_CACHE_DIR=/tmp/expense-flow-uv-cache uv run pytest tests/test_gl_coding_provider_pact.py",
        "build": "tsc --build && npm --workspace frontend/app run build",
        "dev:demo:seed": "npm --workspace backend/core-case-service run dev:demo:seed",
        "dev:auth:seed": "npm --workspace backend/core-case-service run dev:auth:seed",
        "dev:auth:code": "npm --workspace backend/core-case-service run dev:auth:code --",
        "e2e:reset": "npm --workspace backend/core-case-service run e2e:reset",
        "e2e:auth:code": "npm --workspace backend/core-case-service run e2e:auth:code --",
        "e2e:verify": "npm --workspace backend/core-case-service run e2e:verify",
        "test:e2e": "docker compose up -d --wait postgres redis gl-coding && docker compose run --rm postgres-e2e-marker && npm run e2e:reset && playwright test",
        "test:e2e:headed": "docker compose up -d --wait postgres redis gl-coding && docker compose run --rm postgres-e2e-marker && npm run e2e:reset && playwright test --headed",
        "test:e2e:debug": "docker compose up -d --wait postgres redis gl-coding && docker compose run --rm postgres-e2e-marker && npm run e2e:reset && playwright test --debug",
        "dev:events:receive": "sh scripts/receive-local-stage-transition-event.sh",
        "start": "tsc --build && node --env-file=.env backend/core-case-service/dist/index.js",
        "lint": "eslint . --max-warnings=0 && prettier --check \"**/*.{js,mjs,cjs,ts,json}\""
    },
    "repository": {
        "type": "git",
        "url": "git@github.com:AI-Native-2026-06-22-FedStack/expense-flow-project-team-3.git"
    },
    "engines": {
        "node": ">=24.0"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "workspaces": [
        "backend/core-case-service",
        "frontend/app"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.0",
        "@vitest/coverage-v8": "^4.1.10",
        "drizzle-orm": "^0.45.2",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.7.0",
        "prettier": "^3.8.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0",
        "vitest": "^4.1.9"
    },
    "overrides": {
        "@esbuild-kit/esm-loader": "npm:tsx@^4.22.4"
    },
    "dependencies": {
        "@types/pg": "^8.20.0"
    }
}
