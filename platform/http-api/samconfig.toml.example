version = 0.1

[sandbox.deploy.parameters]
stack_name = "expenseflow-http-api-sandbox"
resolve_s3 = true
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
parameter_overrides = "EnvironmentTag=sandbox UserTag=muhilramesh JwtIssuer=https://core-api.example.invalid/v1 JwtAudience=expenseflow-http-api StageName=v1 SpaOrigin=https://spa.example.invalid"

[issue-payment-sandbox.deploy.parameters]
stack_name = "expenseflow-issue-payment-http-api-sandbox"
resolve_s3 = true
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
parameter_overrides = "EnvironmentTag=sandbox UserTag=muhilramesh TicketTag=SCRUM-150 HttpApiId=synthetic-http-api-id SharedJwtAuthorizerId=synthetic-authorizer-id StageName=v1 IssuePaymentFunctionName=expenseflow-issue-payment-stub CoreCaseInternalBaseUrl=https://internal-core-case.expenseflow-sandbox.local CoreCaseInternalCommandTokenSecretArn=arn:aws:secretsmanager:us-east-1:000000000000:secret:expenseflow/sandbox/core-case/internal-command-token RolePermissionsBoundaryArn=REPLACE_WITH_BOUNDARY_ARN"
