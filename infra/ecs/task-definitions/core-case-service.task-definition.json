{
    "family": "expenseflow-core-case-service",
    "taskRoleArn": "${CORE_CASE_TASK_ROLE_ARN}",
    "executionRoleArn": "${ECS_TASK_EXECUTION_ROLE_ARN}",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "512",
    "memory": "1024",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "containerDefinitions": [
        {
            "name": "core-case-service",
            "image": "${CORE_CASE_IMAGE_URI}",
            "essential": true,
            "portMappings": [
                {
                    "name": "http",
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "environment": [
                {
                    "name": "ARGON2_HASH_LENGTH",
                    "value": "32"
                },
                {
                    "name": "ARGON2_MEMORY_COST",
                    "value": "19456"
                },
                {
                    "name": "ARGON2_PARALLELISM",
                    "value": "1"
                },
                {
                    "name": "ARGON2_TIME_COST",
                    "value": "2"
                },
                {
                    "name": "AUTH_ACCESS_TOKEN_TTL_SECONDS",
                    "value": "900"
                },
                {
                    "name": "AUTH_JWT_ISSUER",
                    "value": "expenseflow-core-case-service"
                },
                {
                    "name": "AUTH_JWT_KEY_ID",
                    "value": "${AUTH_JWT_KEY_ID}"
                },
                {
                    "name": "AUTO_APPLY_MIGRATIONS",
                    "value": "false"
                },
                {
                    "name": "AWS_REGION",
                    "value": "${AWS_REGION}"
                },
                {
                    "name": "CASE_QUEUE_ROLLUP_TTL_SECONDS",
                    "value": "30"
                },
                {
                    "name": "CORE_CASE_RATE_LIMIT_REQUESTS",
                    "value": "100"
                },
                {
                    "name": "CORE_CASE_RATE_LIMIT_WINDOW_SECONDS",
                    "value": "60"
                },
                {
                    "name": "CORE_CASE_INTERNAL_ROUTES_ENABLED",
                    "value": "${CORE_CASE_INTERNAL_ROUTES_ENABLED}"
                },
                {
                    "name": "DYNAMODB_EXPENSE_REPORT_TABLE",
                    "value": "${DYNAMODB_EXPENSE_REPORT_TABLE}"
                },
                {
                    "name": "DYNAMODB_EXPENSE_REPORT_TENANT_INDEX",
                    "value": "${DYNAMODB_EXPENSE_REPORT_TENANT_INDEX}"
                },
                {
                    "name": "GL_CODING_BASE_BACKOFF_MS",
                    "value": "100"
                },
                {
                    "name": "GL_CODING_MAX_BACKOFF_MS",
                    "value": "1000"
                },
                {
                    "name": "GL_CODING_MAX_RETRIES",
                    "value": "2"
                },
                {
                    "name": "GL_CODING_SERVICE_BASE_URL",
                    "value": "${GL_CODING_SERVICE_BASE_URL}"
                },
                {
                    "name": "GL_CODING_TIMEOUT_MS",
                    "value": "5000"
                },
                {
                    "name": "IDEMPOTENCY_STORE_BACKEND",
                    "value": "redis"
                },
                {
                    "name": "MFA_TOTP_SECRET_KEY_VERSION",
                    "value": "${MFA_TOTP_SECRET_KEY_VERSION}"
                },
                {
                    "name": "MILEAGE_REIMBURSEMENT_RATE",
                    "value": "0.70"
                },
                {
                    "name": "PORT",
                    "value": "3000"
                },
                {
                    "name": "RECEIPT_STORAGE_BUCKET",
                    "value": "${RECEIPT_STORAGE_BUCKET}"
                },
                {
                    "name": "RECEIPT_STORAGE_FORCE_PATH_STYLE",
                    "value": "false"
                },
                {
                    "name": "RUNTIME_SMOKE_GL_CODING_ENABLED",
                    "value": "${RUNTIME_SMOKE_GL_CODING_ENABLED}"
                },
                {
                    "name": "REDIS_URL",
                    "value": "${REDIS_URL}"
                },
                {
                    "name": "STAGE_TRANSITION_SNS_TOPIC_ARN",
                    "value": "${STAGE_TRANSITION_SNS_TOPIC_ARN}"
                },
                {
                    "name": "TIN_EIN_VALIDATION_BREAKER_ERROR_THRESHOLD_PERCENTAGE",
                    "value": "50"
                },
                {
                    "name": "TIN_EIN_VALIDATION_BREAKER_RESET_TIMEOUT_MS",
                    "value": "30000"
                },
                {
                    "name": "TIN_EIN_VALIDATION_ENDPOINT_URL",
                    "value": "${TIN_EIN_VALIDATION_ENDPOINT_URL}"
                },
                {
                    "name": "TIN_EIN_VALIDATION_OPERATION_NAME",
                    "value": "VerifyTaxpayer"
                },
                {
                    "name": "TIN_EIN_VALIDATION_STATUS_ENRICHMENT_ENABLED",
                    "value": "true"
                },
                {
                    "name": "TIN_EIN_VALIDATION_STATUS_OPERATION_NAME",
                    "value": "GetTaxpayerStatus"
                },
                {
                    "name": "TIN_EIN_VALIDATION_TIMEOUT_MS",
                    "value": "5000"
                },
                {
                    "name": "TIN_EIN_VALIDATION_WSDL_URL",
                    "value": "${TIN_EIN_VALIDATION_WSDL_URL}"
                }
            ],
            "secrets": [
                {
                    "name": "AUTH_JWT_PRIVATE_KEY_BASE64",
                    "valueFrom": "${CORE_CASE_AUTH_JWT_PRIVATE_KEY_SECRET_ARN}"
                },
                {
                    "name": "DATABASE_URL",
                    "valueFrom": "${CORE_CASE_DATABASE_URL_SECRET_ARN}"
                },
                {
                    "name": "MFA_TOTP_SECRET_ENCRYPTION_KEY",
                    "valueFrom": "${CORE_CASE_MFA_TOTP_SECRET_ENCRYPTION_KEY_SECRET_ARN}"
                },
                {
                    "name": "RUNTIME_SMOKE_SHARED_SECRET",
                    "valueFrom": "${CORE_CASE_RUNTIME_SMOKE_SHARED_SECRET_ARN}"
                },
                {
                    "name": "TIN_EIN_VALIDATION_PASSWORD",
                    "valueFrom": "${CORE_CASE_TIN_EIN_VALIDATION_PASSWORD_SECRET_ARN}"
                },
                {
                    "name": "TIN_EIN_VALIDATION_USERNAME",
                    "valueFrom": "${CORE_CASE_TIN_EIN_VALIDATION_USERNAME_SECRET_ARN}"
                }
            ],
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "node -e \"fetch('http://127.0.0.1:' + (process.env.PORT || 3000) + '/health').then((response) => { if (!response.ok) process.exit(1); }).catch(() => process.exit(1));\""
                ],
                "interval": 30,
                "timeout": 3,
                "retries": 3,
                "startPeriod": 10
            },
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "${CORE_CASE_LOG_GROUP_NAME}",
                    "awslogs-region": "${AWS_REGION}",
                    "awslogs-stream-prefix": "core-case-service"
                }
            }
        }
    ]
}
