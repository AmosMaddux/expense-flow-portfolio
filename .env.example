POSTGRES_DB=expenseflow_core_case
POSTGRES_USER=expenseflow
POSTGRES_PASSWORD=expenseflow_local_dev_only
DATABASE_URL=postgres://expenseflow:expenseflow_local_dev_only@127.0.0.1:55432/expenseflow_core_case
REDIS_URL=redis://127.0.0.1:56379
DYNAMODB_IDEMPOTENCY_TABLE_NAME=expenseflow-idempotency-local
DYNAMODB_ENDPOINT=http://127.0.0.1:58000
AWS_ENDPOINT_URL_DYNAMODB=http://127.0.0.1:58000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=expenseflowlocal
AWS_SECRET_ACCESS_KEY=expenseflowlocaldevonly
STAGE_TRANSITION_SNS_TOPIC_ARN=replace-with-local-stage-transition-topic-identifier
STAGE_TRANSITION_SNS_ENDPOINT=http://127.0.0.1:4566
STAGE_TRANSITION_SQS_QUEUE_URL=http://127.0.0.1:4566/000000000000/expenseflow-stage-transition-events-local
STAGE_TRANSITION_SQS_ENDPOINT=http://127.0.0.1:4566
MINIO_ROOT_USER=expenseflowlocal
MINIO_ROOT_PASSWORD=expenseflowlocaldevonly
RECEIPT_STORAGE_BUCKET=expenseflow-receipts-local
RECEIPT_STORAGE_ENDPOINT=http://127.0.0.1:59000
RECEIPT_STORAGE_FORCE_PATH_STYLE=true
PORT=3301
VITE_API_BASE_URL=http://127.0.0.1:3301
VITE_TENANT_ID=8e2bfbb1-9f72-4810-b8b1-a02a25cdd2fb
EXPENSEFLOW_DEV_PASSWORD=expenseflow-local-dev-only
AUTO_APPLY_MIGRATIONS=true
CASE_QUEUE_ROLLUP_TTL_SECONDS=30
DYNAMODB_EXPENSE_REPORT_TABLE=expenseflow-expense-reports
DYNAMODB_EXPENSE_REPORT_TENANT_INDEX=tenantId-index
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32
AUTH_JWT_ISSUER=expenseflow-core-case-service
# Generate local JWT keys with ./scripts/generate-dev-jwt-keys.sh.
# The script writes to gitignored .env by default, or to a caller-provided temp env file for tests.
# Never commit generated JWT keys, PEM blocks, access tokens, refresh tokens, or real env values.
AUTH_JWT_PRIVATE_KEY_BASE64=replace-with-base64-encoded-rsa-private-key
AUTH_JWT_KEY_ID=local-dev-rs256-v1
AUTH_JWT_JWKS_JSON={"keys":[{"kty":"RSA","kid":"local-dev-rs256-v1","use":"sig","alg":"RS256","n":"replace-with-rsa-modulus","e":"AQAB"}]}
# Deployed verifier services can use AUTH_JWT_JWKS_URL instead of local AUTH_JWT_JWKS_JSON.
# AUTH_JWT_JWKS_URL=http://core-case-service.example.invalid/v1/.well-known/jwks.json
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
GL_CODING_SERVICE_BASE_URL=http://127.0.0.1:8001
GL_CODING_TIMEOUT_MS=5000
GL_CODING_MAX_RETRIES=2
GL_CODING_BASE_BACKOFF_MS=100
GL_CODING_MAX_BACKOFF_MS=1000
TIN_EIN_VALIDATION_WSDL_URL=https://tin-ein.example.test/tivs?wsdl
TIN_EIN_VALIDATION_ENDPOINT_URL=https://tin-ein.example.test/tivs
TIN_EIN_VALIDATION_OPERATION_NAME=VerifyTaxpayer
TIN_EIN_VALIDATION_STATUS_OPERATION_NAME=GetTaxpayerStatus
TIN_EIN_VALIDATION_STATUS_ENRICHMENT_ENABLED=true
TIN_EIN_VALIDATION_USERNAME=replace-with-tivs-username
TIN_EIN_VALIDATION_PASSWORD=replace-with-tivs-password
TIN_EIN_VALIDATION_TIMEOUT_MS=5000
TIN_EIN_VALIDATION_BREAKER_ERROR_THRESHOLD_PERCENTAGE=50
TIN_EIN_VALIDATION_BREAKER_RESET_TIMEOUT_MS=30000
CORE_CASE_RATE_LIMIT_REQUESTS=100
CORE_CASE_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_JWT_CLOCK_SKEW_SECONDS=10
MILEAGE_REIMBURSEMENT_RATE=0.70
MFA_TOTP_SECRET_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
MFA_TOTP_SECRET_KEY_VERSION=local-dev-v1
PACT_BROKER_BASE_URL=https://pact-broker.example.test
PACT_BROKER_TOKEN=replace-with-pact-broker-token
PACT_CONSUMER_VERSION=replace-with-build-version
