POSTGRES_DB=expenseflow_core_case
POSTGRES_USER=expenseflow
POSTGRES_PASSWORD=expenseflow_local_dev_only
DATABASE_URL=postgres://expenseflow:expenseflow_local_dev_only@127.0.0.1:55432/expenseflow_core_case
REDIS_URL=redis://127.0.0.1:56379
DYNAMODB_IDEMPOTENCY_TABLE_NAME=expenseflow-idempotency-local
DYNAMODB_ENDPOINT=http://127.0.0.1:58000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=expenseflow-local
AWS_SECRET_ACCESS_KEY=expenseflow-local
PORT=3301
AUTO_APPLY_MIGRATIONS=true
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32
AUTH_JWT_ISSUER=expenseflow-core-case-service
# Generate local JWT keys with ./scripts/generate-dev-jwt-keys.sh.
# The script writes to gitignored .env by default, or to a caller-provided temp env file for tests.
# Never commit generated JWT keys, PEM blocks, access tokens, refresh tokens, or real env values.
AUTH_JWT_PRIVATE_KEY_BASE64=replace-with-base64-encoded-rsa-private-key
# FastAPI can validate a single local key with AUTH_JWT_PUBLIC_KEY_BASE64, or rotate keys with:
# AUTH_JWT_PUBLIC_KEYS_JSON={"local-dev-rs256-v1":"base64-public-key","next-key-id":"base64-public-key"}
AUTH_JWT_PUBLIC_KEY_BASE64=replace-with-base64-encoded-rsa-public-key
AUTH_JWT_KEY_ID=local-dev-rs256-v1
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
CORE_CASE_RATE_LIMIT_REQUESTS=100
CORE_CASE_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_JWT_CLOCK_SKEW_SECONDS=10
MFA_TOTP_SECRET_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
MFA_TOTP_SECRET_KEY_VERSION=local-dev-v1
PACT_BROKER_BASE_URL=https://pact-broker.example.test
PACT_BROKER_TOKEN=replace-with-pact-broker-token
PACT_CONSUMER_VERSION=replace-with-build-version
